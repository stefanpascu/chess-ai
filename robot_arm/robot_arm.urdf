<?xml version="1.0"?>
<robot name="robot_arm">
  <!-- Base Link -->
  <link name="base_link">
    <inertial>
      <origin rpy="1.5708 0 0" xyz="0  0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="Base.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="gray">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="Base.STL" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <!-- Rest of the file remains the same -->
  <!-- Waist Link -->
  <link name="waist_link">
    <inertial>
      <origin rpy="1.5708 0 1" xyz="-0.65 -0.152 0.54"/>
      <mass value="0.8"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 0 1" xyz="-0.65 -0.152 0.54"/>
      <geometry>
        <mesh filename="Waist.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5708 0 1" xyz="-0.65 -0.152 0.54"/>
      <geometry>
        <mesh filename="Waist.STL" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <!-- Arm 01 Link -->
  <link name="arm01_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.006"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="Arm 01.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="orange">
        <color rgba="1 0.5 0 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="Arm 01.STL" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <!-- Arm 02 Link -->
  <link name="arm02_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.006"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="Arm 02 v3.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="orange">
        <color rgba="1 0.5 0 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="Arm 02 v3.STL" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <!-- Arm 03 Link -->
  <link name="arm03_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="Arm 03.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="orange">
        <color rgba="1 0.5 0 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="Arm 03.STL" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <!-- Gripper Base Link -->
  <link name="gripper_base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="Gripper base.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="Gripper base.STL" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <!-- Gripper Link -->
  <link name="gripper_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="Gripper 1.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="Gripper 1.STL" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <!-- Grip Link -->
  <link name="grip_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="grip link 1.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="grip link 1.STL" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <!-- Gear Links -->
  <link name="gear1_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="gear1.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="green">
        <color rgba="0.2 0.8 0.2 1"/>
      </material>
    </visual>
  </link>

  <link name="gear2_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="gear2.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="green">
        <color rgba="0.2 0.8 0.2 1"/>
      </material>
    </visual>
  </link>

  <!-- Joints -->
  <joint name="base_to_waist" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="waist_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" lower="-3.14" upper="3.14" velocity="1.0"/>
  </joint>

  <joint name="waist_to_arm01" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.05"/>
    <parent link="waist_link"/>
    <child link="arm01_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="-1.57" upper="1.57" velocity="1.0"/>
  </joint>

  <joint name="arm01_to_arm02" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.1"/>
    <parent link="arm01_link"/>
    <child link="arm02_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="-1.57" upper="1.57" velocity="1.0"/>
  </joint>

  <joint name="arm02_to_arm03" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.1"/>
    <parent link="arm02_link"/>
    <child link="arm03_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="-1.57" upper="1.57" velocity="1.0"/>
  </joint>

  <joint name="arm03_to_gripper_base" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.1"/>
    <parent link="arm03_link"/>
    <child link="gripper_base_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" lower="-3.14" upper="3.14" velocity="1.0"/>
  </joint>

  <joint name="gripper_base_to_gripper" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.025"/>
    <parent link="gripper_base_link"/>
    <child link="gripper_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="-0.785" upper="0.785" velocity="1.0"/>
  </joint>

  <joint name="gripper_to_grip" type="revolute">
    <origin rpy="0 0 0" xyz="0 0.025 0"/>
    <parent link="gripper_link"/>
    <child link="grip_link"/>
    <axis xyz="1 0 0"/>
    <limit effort="100" lower="-0.5" upper="0.5" velocity="1.0"/>
  </joint>

  <joint name="gear1_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.015 0 0.04"/>
    <parent link="arm02_link"/>
    <child link="gear1_link"/>
  </joint>

  <joint name="gear2_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.015 0 0.04"/>
    <parent link="arm02_link"/>
    <child link="gear2_link"/>
  </joint>
</robot>